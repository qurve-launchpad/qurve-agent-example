# ──────────────────────────────────────────────────────────────
# LLM (default: Groq, free for testing)
# Get a free key: https://console.groq.com/keys
# ──────────────────────────────────────────────────────────────
LLM_PROVIDER=groq
LLM_API_KEY=gsk_.......
LLM_MODEL=openai/gpt-oss-120b
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=1500
# LLM_BASE_URL=            # set this when switching to another OpenAI-compatible provider

# ──────────────────────────────────────────────────────────────
# Server
# ──────────────────────────────────────────────────────────────
PORT=4000
PUBLIC_URL=http://localhost:4000

QURVE_API_URL=https://qurve.online

# ──────────────────────────────────────────────────────────────
# RPC per chain (optional — falls back to public RPC)
#
# Use a private RPC (Alchemy / QuickNode / etc.) for production —
# public RPCs are often rate-limited when hit frequently from a server.
# ──────────────────────────────────────────────────────────────
ARC_RPC_URL=https://rpc.testnet.arc.io
BASE_RPC_URL=https://mainnet.base.org
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
ROBINHOOD_RPC_URL=https://rpc.mainnet.chain.robinhood.com
BOT_RPC_URL=https://rpc.botchain.ai

# ──────────────────────────────────────────────────────────────
# Chains queried by default (comma-separated chain IDs)
#
# Default: BOT, Base, Robinhood, Arc. Adjust as needed —
# if you develop against a testnet, swap 8453 -> 84532.
# ──────────────────────────────────────────────────────────────
PORTFOLIO_CHAINS=677,8453,4663,5042002

# ──────────────────────────────────────────────────────────────
# Server (public URL)
#
# PUBLIC_URL MUST be set to your public domain in deployment —
# it is embedded in agent-card.json so A2A clients can reach you.
# ──────────────────────────────────────────────────────────────
PORT=4000
PUBLIC_URL=http://localhost:4000
