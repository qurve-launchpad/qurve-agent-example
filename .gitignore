# ──────────────────────────────────────────────────────────────
# ENVIRONMENT
#
# Never commit real secrets. Keep .env.example (template) but ignore
# all real .env files. If a .env slips through, rotate the keys.
# ──────────────────────────────────────────────────────────────
.env
.env.local
.env.*.local
.env.development
.env.production
.env.test
.railwayignore
!.env.example

